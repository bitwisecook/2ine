<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.18"/>
  <requires lib="Adw" version="1.9"/>
  <menu id="menu">
    <section>
      <item><attribute name="label" translatable="yes">New Ball…</attribute><attribute name="action">win.new</attribute></item>
      <item><attribute name="label" translatable="yes">Open Ball…</attribute><attribute name="action">win.open</attribute></item>
      <item><attribute name="label" translatable="yes">Import Ball from ZIP…</attribute><attribute name="action">win.import</attribute></item>
    </section>
    <section>
      <submenu><attribute name="label" translatable="yes">Ball</attribute>
        <section>
          <item><attribute name="label" translatable="yes">Rename…</attribute><attribute name="action">win.rename-ball</attribute></item>
          <item><attribute name="label" translatable="yes">Move to Trash…</attribute><attribute name="action">win.trash-ball</attribute></item>
          <item><attribute name="label" translatable="yes">Remove Missing Ball from List</attribute><attribute name="action">win.forget-ball</attribute><attribute name="hidden-when">action-disabled</attribute></item>
        </section>
        <section>
          <item><attribute name="label" translatable="yes">Export as ZIP…</attribute><attribute name="action">win.export</attribute></item>
          <item><attribute name="label" translatable="yes">Open Folder</attribute><attribute name="action">win.reveal</attribute></item>
          <item><attribute name="label" translatable="yes">Copy Path</attribute><attribute name="action">win.copy</attribute></item>
        </section>
      </submenu>
      <submenu><attribute name="label" translatable="yes">Runtime and OS/2 Files</attribute>
        <section>
          <item><attribute name="label" translatable="yes">Choose Runtime…</attribute><attribute name="action">win.runtime</attribute></item>
          <item><attribute name="label" translatable="yes">Install OS/2 Files…</attribute><attribute name="action">win.os2-files</attribute></item>
          <item><attribute name="label" translatable="yes">Check and Restore System Libraries…</attribute><attribute name="action">win.restore-libraries</attribute></item>
        </section>
      </submenu>
      <submenu><attribute name="label" translatable="yes">Drives</attribute>
        <section>
          <item><attribute name="label" translatable="yes">Add Drive…</attribute><attribute name="action">win.add-drive</attribute></item>
          <item><attribute name="label" translatable="yes">Create Disk Image…</attribute><attribute name="action">win.create-disk</attribute></item>
          <item><attribute name="label" translatable="yes">Create Floppy Image…</attribute><attribute name="action">win.create-floppy</attribute></item>
        </section>
      </submenu>
    </section>
    <section>
      <item><attribute name="label" translatable="yes">Undo Ball Change</attribute><attribute name="action">win.undo</attribute></item>
      <item><attribute name="label" translatable="yes">Redo Ball Change</attribute><attribute name="action">win.redo</attribute></item>
      <item><attribute name="label" translatable="yes">Stop Operation</attribute><attribute name="action">win.stop</attribute><attribute name="hidden-when">action-disabled</attribute></item>
      <item><attribute name="label" translatable="yes">Force Stop Operation</attribute><attribute name="action">win.force-stop</attribute><attribute name="hidden-when">action-disabled</attribute></item>
    </section>
    <section>
      <item><attribute name="label" translatable="yes">Preferences</attribute><attribute name="action">win.preferences</attribute></item>
      <item><attribute name="label" translatable="yes">Keyboard Shortcuts</attribute><attribute name="action">win.shortcuts</attribute></item>
      <item><attribute name="label" translatable="yes">Help</attribute><attribute name="action">win.help</attribute></item>
      <item><attribute name="label" translatable="yes">About 2ine</attribute><attribute name="action">win.about</attribute></item>
    </section>
  </menu>
  <object class="AdwToastOverlay" id="overlay">
    <property name="child">
      <object class="AdwNavigationSplitView" id="split">
        <property name="min-sidebar-width">220</property>
        <property name="max-sidebar-width">290</property>
        <property name="sidebar">
          <object class="AdwNavigationPage">
            <property name="title" translatable="yes">Ball</property>
            <property name="child">
              <object class="AdwToolbarView" id="sidebar">
                <child type="top">
                  <object class="AdwHeaderBar">
                    <property name="show-end-title-buttons">false</property>
                    <child type="start"><object class="GtkButton"><property name="icon-name">list-add-symbolic</property><property name="tooltip-text" translatable="yes">New Ball (Ctrl+N)</property><property name="action-name">win.new</property><accessibility><property name="label" translatable="yes">New ball</property></accessibility></object></child>
                    <child type="end"><object class="GtkMenuButton" id="sidebar_menu"><property name="visible">false</property><property name="icon-name">open-menu-symbolic</property><property name="tooltip-text" translatable="yes">Main Menu</property><property name="primary">true</property><property name="menu-model">menu</property><accessibility><property name="label" translatable="yes">Main menu</property></accessibility></object></child>
                  </object>
                </child>
                <property name="content"><object class="GtkScrolledWindow"><property name="hscrollbar-policy">never</property><property name="child"><object class="GtkListBox" id="ball_list"><property name="selection-mode">single</property><style><class name="navigation-sidebar"/></style><accessibility><property name="label" translatable="yes">Ball</property></accessibility></object></property></object></property>
              </object>
            </property>
          </object>
        </property>
        <property name="content">
          <object class="AdwNavigationPage" id="detail">
            <property name="title">2ine</property>
            <property name="child">
              <object class="AdwToolbarView">
                <child type="top"><object class="AdwHeaderBar" id="header">
                  <child type="start"><object class="GtkButton"><property name="icon-name">view-refresh-symbolic</property><property name="tooltip-text" translatable="yes">Refresh Ball (Ctrl+R)</property><property name="action-name">win.refresh</property><accessibility><property name="label" translatable="yes">Refresh ball</property></accessibility></object></child>
                  <child type="end"><object class="GtkMenuButton" id="detail_menu"><property name="icon-name">open-menu-symbolic</property><property name="tooltip-text" translatable="yes">Main Menu</property><property name="primary">true</property><property name="menu-model">menu</property><accessibility><property name="label" translatable="yes">Main menu</property></accessibility></object></child>
                  <child type="end"><object class="GtkSpinner" id="spinner"><property name="visible">false</property><accessibility><property name="label" translatable="yes">Working</property></accessibility></object></child>
                </object></child>
                <child type="top"><object class="AdwBanner" id="banner"><property name="revealed">false</property><property name="use-markup">false</property></object></child>
                <property name="content"><object class="GtkBox" id="content"><property name="orientation">vertical</property><property name="vexpand">true</property></object></property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
