option(TWOINE_OPENGL "Build the Mesa OS/2 OpenGL and PGL module" OFF)
if(NOT TWOINE_OPENGL)
    return()
endif()
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(_twoine_gl_default mesa)
elseif(APPLE)
    set(_twoine_gl_default kosmickrisp)
else()
    message(FATAL_ERROR "OpenGL is implemented only for Linux Mesa and macOS KosmicKrisp.")
endif()
set(TWOINE_OPENGL_BACKEND "${_twoine_gl_default}" CACHE STRING "Host graphics implementation")
set_property(CACHE TWOINE_OPENGL_BACKEND PROPERTY STRINGS mesa kosmickrisp)
set(TWOINE_MESA_ROOT "" CACHE PATH "Mesa installation prefix")
set(TWOINE_KOSMICKRISP_ICD "" CACHE FILEPATH "KosmicKrisp Vulkan ICD JSON file")
if(NOT TWOINE_OPENGL_BACKEND STREQUAL _twoine_gl_default)
    message(FATAL_ERROR "Backend '${TWOINE_OPENGL_BACKEND}' is not implemented on ${CMAKE_SYSTEM_NAME}; use ${_twoine_gl_default}. Vulkan and DirectX adapters are not implemented.")
endif()
if(APPLE)
    if(NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
        message(FATAL_ERROR "KosmicKrisp requires Apple Silicon and macOS 26 or newer.")
    endif()
    if(NOT TWOINE_MESA_ROOT OR NOT EXISTS "${TWOINE_KOSMICKRISP_ICD}")
        message(FATAL_ERROR "Set TWOINE_MESA_ROOT to Mesa with EGL/Zink and TWOINE_KOSMICKRISP_ICD to its KosmicKrisp ICD JSON. See docs/opengl.md.")
    endif()
    if(CMAKE_OSX_DEPLOYMENT_TARGET AND CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS 26)
        message(FATAL_ERROR "KosmicKrisp requires a macOS deployment target of 26 or newer.")
    endif()
    find_path(TWOINE_EGL_INCLUDE_DIR EGL/egl.h PATHS "${TWOINE_MESA_ROOT}/include" NO_DEFAULT_PATH REQUIRED)
    find_library(TWOINE_EGL_LIBRARY NAMES EGL PATHS "${TWOINE_MESA_ROOT}/lib" NO_DEFAULT_PATH REQUIRED)
else()
    find_path(TWOINE_EGL_INCLUDE_DIR EGL/egl.h HINTS "${TWOINE_MESA_ROOT}/include" REQUIRED)
    # A native application is i386 even on an x86_64 host. Let its linker select
    # the matching multilib library instead of finding a host-architecture .so.
    set(TWOINE_EGL_LIBRARY EGL)
endif()
