option(TWOINE_MT32_SYNTH "Enable optional Munt MT-32 synthesis with user-supplied ROMs" OFF)
set(TWOINE_MT32_SOURCE_DIR "" CACHE PATH "Offline Munt source root containing mt32emu/")
add_library(twoine_mt32_config INTERFACE)
if(NOT TWOINE_MT32_SYNTH)
    target_compile_definitions(twoine_mt32_config INTERFACE TWOINE_MT32_SYNTH=0)
    return()
endif()
enable_language(CXX)
set(libmt32emu_SHARED OFF CACHE BOOL "" FORCE)
set(libmt32emu_C_INTERFACE ON CACHE BOOL "" FORCE)
set(libmt32emu_BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(libmt32emu_WITH_INTERNAL_RESAMPLER ON CACHE BOOL "" FORCE)
if(TWOINE_MT32_SOURCE_DIR)
    if(NOT EXISTS "${TWOINE_MT32_SOURCE_DIR}/mt32emu/CMakeLists.txt")
        message(FATAL_ERROR "TWOINE_MT32_SOURCE_DIR must contain the Munt mt32emu source directory")
    endif()
    file(READ "${TWOINE_MT32_SOURCE_DIR}/mt32emu/cmake/project_data.cmake" _twoine_mt32_version)
    foreach(part MAJOR MINOR PATCH)
        if(part STREQUAL "MAJOR")
            set(expected 2)
        elseif(part STREQUAL "MINOR")
            set(expected 8)
        else()
            set(expected 3)
        endif()
        if(NOT _twoine_mt32_version MATCHES "set\\(libmt32emu_VERSION_${part} ${expected}\\)")
            message(FATAL_ERROR "Offline Munt source must provide libmt32emu 2.8.3")
        endif()
    endforeach()
    add_subdirectory("${TWOINE_MT32_SOURCE_DIR}/mt32emu" "${PROJECT_BINARY_DIR}/_deps/mt32emu-build" EXCLUDE_FROM_ALL)
else()
    include(FetchContent)
    FetchContent_Declare(twoine_munt
        URL "https://codeload.github.com/munt/munt/tar.gz/refs/tags/libmt32emu_2_8_3"
        URL_HASH SHA256=81f8c462f46bc8901618762ae34cf9de93894ff81f41db73c79472fa3baef875
        SOURCE_SUBDIR mt32emu)
    FetchContent_MakeAvailable(twoine_munt)
endif()
set_target_properties(mt32emu PROPERTIES POSITION_INDEPENDENT_CODE ON)
if(TWOINE_NATIVE_LOADER)
    target_compile_options(mt32emu PRIVATE -m32)
    target_link_options(twoine_mt32_config INTERFACE -m32)
endif()
target_compile_definitions(twoine_mt32_config INTERFACE TWOINE_MT32_SYNTH=1 MT32EMU_API_TYPE=1)
target_link_libraries(twoine_mt32_config INTERFACE MT32Emu::mt32emu)
