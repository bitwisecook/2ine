set(TWOINE_FREETYPE_VERSION 2.14.3)
set(TWOINE_FREETYPE_SOURCE_DIR "" CACHE PATH "Local FreeType 2.14.3 source directory")
set(TWOINE_FONT_DATA_DIR "" CACHE PATH "Local Liberation 2.1.5 TrueType font directory")
if(TWOINE_FREETYPE_SOURCE_DIR)
    file(READ "${TWOINE_FREETYPE_SOURCE_DIR}/include/freetype/freetype.h" _twoine_ft_header)
    foreach(component MAJOR MINOR PATCH)
        string(REGEX MATCH "#define[ \t]+FREETYPE_${component}[ \t]+([0-9]+)" _match "${_twoine_ft_header}")
        set(_twoine_ft_${component} "${CMAKE_MATCH_1}")
    endforeach()
    if(NOT "${_twoine_ft_MAJOR}.${_twoine_ft_MINOR}.${_twoine_ft_PATCH}" VERSION_EQUAL TWOINE_FREETYPE_VERSION)
        message(FATAL_ERROR "TWOINE_FREETYPE_SOURCE_DIR must contain FreeType ${TWOINE_FREETYPE_VERSION}")
    endif()
endif()
set(_twoine_ft_url https://download.savannah.gnu.org/releases/freetype/freetype-2.14.3.tar.xz)
set(_twoine_ft_hash SHA256=36bc4f1cc413335368ee656c42afca65c5a3987e8768cc28cf11ba775e785a5f)
set(_twoine_ft_options -DFT_DISABLE_ZLIB=ON -DFT_DISABLE_BZIP2=ON -DFT_DISABLE_PNG=ON
    -DFT_DISABLE_HARFBUZZ=ON -DFT_DISABLE_BROTLI=ON -DBUILD_SHARED_LIBS=OFF
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON)
if(TWOINE_NATIVE_LOADER)
    include("${PROJECT_SOURCE_DIR}/hal/linux/i386/dependencies.cmake")
    twoine_add_native_freetype()

else()
    foreach(dependency ZLIB BZIP2 PNG HARFBUZZ BROTLI)
        set(FT_DISABLE_${dependency} ON CACHE BOOL "Standalone FreeType" FORCE)
    endforeach()
    set(BUILD_SHARED_LIBS OFF)
    if(TWOINE_FREETYPE_SOURCE_DIR)
        add_subdirectory("${TWOINE_FREETYPE_SOURCE_DIR}" "${PROJECT_BINARY_DIR}/_deps/freetype-build" EXCLUDE_FROM_ALL)
    else()
        include(FetchContent)
        FetchContent_Declare(freetype URL "${_twoine_ft_url}" URL_HASH "${_twoine_ft_hash}")
        FetchContent_MakeAvailable(freetype)
    endif()
    set_target_properties(freetype PROPERTIES POSITION_INDEPENDENT_CODE ON)
    add_library(twoine_freetype ALIAS freetype)
endif()
if(NOT TWOINE_FONT_DATA_DIR)
    include(FetchContent)
    FetchContent_Declare(twoine_fontdata
        URL https://github.com/liberationfonts/liberation-fonts/files/7261482/liberation-fonts-ttf-2.1.5.tar.gz
        URL_HASH SHA256=7191c669bf38899f73a2094ed00f7b800553364f90e2637010a69c0e268f25d0)
    FetchContent_MakeAvailable(twoine_fontdata)
    set(TWOINE_FONT_DATA_DIR "${twoine_fontdata_SOURCE_DIR}")
endif()
file(MAKE_DIRECTORY "${PROJECT_BINARY_DIR}/fonts")
foreach(family Sans Serif Mono)
    foreach(style Regular Bold Italic BoldItalic)
        if(NOT EXISTS "${TWOINE_FONT_DATA_DIR}/Liberation${family}-${style}.ttf")
            message(FATAL_ERROR "Missing Liberation font: ${family}-${style}")
        endif()
        configure_file("${TWOINE_FONT_DATA_DIR}/Liberation${family}-${style}.ttf"
            "${PROJECT_BINARY_DIR}/fonts/Liberation${family}-${style}.ttf" COPYONLY)
    endforeach()
endforeach()

configure_file("${TWOINE_FONT_DATA_DIR}/LICENSE" "${PROJECT_BINARY_DIR}/fonts/LICENSE" COPYONLY)
set(TWOINE_RUNTIME_FONT_DIR "${PROJECT_BINARY_DIR}/fonts")
