+static void FitGameView(ULONG width, ULONG height, SETUP_BLITTER *blitter)
+{
+   const char *keep_aspect = getenv("TWOINE_KEEP_ASPECT");
+   blitter->ulDstWidth = width;
+   blitter->ulDstHeight = height;
+   blitter->lDstPosX = blitter->lDstPosY = 0;
+   if (keep_aspect && keep_aspect[0] == '0' && !keep_aspect[1]) return;
+   blitter->ulDstHeight = width * 3 / 4;
+   if (blitter->ulDstHeight > height)
+   {
+      blitter->ulDstHeight = height;
+      blitter->ulDstWidth = height * 4 / 3;
+   }
+   if (!blitter->ulDstWidth) blitter->ulDstWidth = 1;
+   if (!blitter->ulDstHeight) blitter->ulDstHeight = 1;
+   blitter->lDstPosX = (width - blitter->ulDstWidth) / 2;
+   blitter->lDstPosY = (height - blitter->ulDstHeight) / 2;
+}
