    { "kind": "folder", "path": "TwoineBallsUITests", "target-membership": [ "TwoineBallsUITests" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/TwoineBalls.app", "id": "B96C113D3097EDCE005E53CF", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/TwoineBallsTests.xctest", "id": "B96C114A3097EDD0005E53CF", "type": "wrapper.cfbundle", "index": false },
